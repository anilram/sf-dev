    <webLinks>
        <fullName>CRMforNonProfit__Send_Emails</fullName>
        <availability>online</availability>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Send Emails</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/10.0/connection.js&quot;)}
{!REQUIRESCRIPT(&quot;/soap/ajax/10.0/apex.js&quot;)}
var result = sforce.apex.execute(&quot;CRMforNonProfit.JV_AWS_SES_CampaignEmailSender&quot;,&quot;sendEmailToCampaingMembers&quot;, {objectId:&quot;{!Campaign.Id}&quot;});
window.alert(result);
document.location.reload(true);</url>
    </webLinks>
