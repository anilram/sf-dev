    <webLinks>
        <fullName>CRMforNonProfit__RepairTransaction</fullName>
        <availability>online</availability>
        <description>Podle párovacích pravidel zopakuje vyhledání kontaktu a kampaně</description>
        <displayType>button</displayType>
        <linkType>javascript</linkType>
        <masterLabel>Opakuj vyhledání Kontaktu a Kampaně</masterLabel>
        <openType>onClickJavaScript</openType>
        <protected>false</protected>
        <url>{!REQUIRESCRIPT(&quot;/soap/ajax/10.0/connection.js&quot;)}
{!REQUIRESCRIPT(&quot;/soap/ajax/10.0/apex.js&quot;)}
var result = sforce.apex.execute(&quot;CRMforNonProfit.TransactionProcessor&quot;,&quot;RepairTransaction&quot;, {transactionId:&quot;{!CRMforNonProfit__Transaction__c.Id}&quot;});
window.alert(result);
document.location.reload(true);</url>
    </webLinks>
</CustomObject>