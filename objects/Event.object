<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <listViews>
        <fullName>MyRecentEvents</fullName>
        <columns>START_DATE_TIME</columns>
        <columns>END_DATE_TIME</columns>
        <columns>SUBJECT</columns>
        <columns>WHO_NAME</columns>
        <columns>WHAT_NAME</columns>
        <columns>CORE.USERS.ALIAS</columns>
        <columns>ALL_DAY</columns>
        <filterScope>Mine</filterScope>
        <filters>
            <field>DUE_DATE</field>
            <operation>equals</operation>
            <value>LAST_N_DAYS:60</value>
        </filters>
        <label>My Recent Events</label>
    </listViews>
    <listViews>
        <fullName>MyTeamsRecentEvents</fullName>
        <columns>START_DATE_TIME</columns>
        <columns>END_DATE_TIME</columns>
        <columns>SUBJECT</columns>
        <columns>WHO_NAME</columns>
        <columns>WHAT_NAME</columns>
        <columns>CORE.USERS.ALIAS</columns>
        <columns>ALL_DAY</columns>
        <filterScope>Team</filterScope>
        <filters>
            <field>DUE_DATE</field>
            <operation>equals</operation>
            <value>LAST_N_DAYS:30</value>
        </filters>
        <label>My Team&apos;s Recent Events</label>
    </listViews>
    <listViews>
        <fullName>MyTeamsUpcomingEvents</fullName>
        <columns>START_DATE_TIME</columns>
        <columns>END_DATE_TIME</columns>
        <columns>SUBJECT</columns>
        <columns>WHO_NAME</columns>
        <columns>WHAT_NAME</columns>
        <columns>CORE.USERS.ALIAS</columns>
        <columns>ALL_DAY</columns>
        <filterScope>Team</filterScope>
        <filters>
            <field>DUE_DATE</field>
            <operation>equals</operation>
            <value>TODAY,NEXT_N_DAYS:30</value>
        </filters>
        <label>My Team&apos;s Upcoming Events</label>
    </listViews>
    <listViews>
        <fullName>MyUpcomingEvents</fullName>
        <columns>START_DATE_TIME</columns>
        <columns>END_DATE_TIME</columns>
        <columns>SUBJECT</columns>
        <columns>WHO_NAME</columns>
        <columns>WHAT_NAME</columns>
        <columns>CORE.USERS.ALIAS</columns>
        <columns>ALL_DAY</columns>
        <filterScope>Mine</filterScope>
        <filters>
            <field>DUE_DATE</field>
            <operation>equals</operation>
            <value>TODAY,NEXT_N_DAYS:60</value>
        </filters>
        <label>My Upcoming Events</label>
    </listViews>
    <listViews>
        <fullName>TodaysAgenda</fullName>
        <columns>START_DATE_TIME</columns>
        <columns>END_DATE_TIME</columns>
        <columns>SUBJECT</columns>
        <columns>WHO_NAME</columns>
        <columns>WHAT_NAME</columns>
        <columns>CORE.USERS.ALIAS</columns>
        <columns>ALL_DAY</columns>
        <filterScope>Mine</filterScope>
        <filters>
            <field>DUE_DATE</field>
            <operation>lessOrEqual</operation>
            <value>TODAY</value>
        </filters>
        <filters>
            <field>END_DATE</field>
            <operation>greaterOrEqual</operation>
            <value>TODAY</value>
        </filters>
        <label>Today&apos;s Agenda</label>
    </listViews>
</CustomObject>