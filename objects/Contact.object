    <fields>
        <fullName>CRMforNonProfit__Letter_Title__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF( CONTAINS( TEXT( Salutation), &quot;paní&quot;), 
       &quot;Vážená paní&quot;, 
       IF( CONTAINS( TEXT( Salutation), &quot;pan&quot;), 
            &quot;Vážený pane&quot;, 
            Text( Salutation)))</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
