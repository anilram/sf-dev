    </fields>
    <fields>
        <fullName>CRMforNonProfit__DniMeziDary__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>IF(  CRMforNonProfit__noac_pocet_financnich_daru__c &gt; 0, ( DATEVALUE( CRMforNonProfit__noac_datum_posledniho_financniho_daru__c) -  CRMforNonProfit__First_Transaction_Date__c ) / CRMforNonProfit__noac_pocet_financnich_daru__c , 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Počet dní mezi dary</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>CRMforNonProfit__DniOdPoslednihoDaru__c</fullName>
        <deprecated>false</deprecated>
        <externalId>false</externalId>
        <formula>TODAY() - DATEVALUE( CRMforNonProfit__noac_datum_posledniho_financniho_daru__c)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Počet dní od posledního daru</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
